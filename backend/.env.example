# ===== TravelAI 旅行智脑 环境变量示例 =====
# 复制为 .env 后按需修改。未配置 LLM Key 时，系统自动降级为规则引擎（仍可生成完整行程）。
# 注意：请在本目录（backend/）下创建 .env，app/config.py 会以绝对路径加载它。

# ---- 应用 ----
APP_NAME=TravelAI
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api

# ---- 数据库 ----
# 默认使用项目根 data/travelai.db（绝对路径，与启动目录无关），无需显式配置。
# 如需自定义，取消下面一行的注释并修改；切 PostgreSQL 参考第二行示例。
# DATABASE_URL=sqlite:///./data/travelai.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/travelai

# ---- Redis（可选，留空则使用内存缓存）----
REDIS_URL=

# ---- JWT（上线务必更换 SECRET_KEY）----
SECRET_KEY=travelai-dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 默认管理员（首次启动自动创建）----
ADMIN_PASSWORD=admin123456

# ---- LLM（OpenAI 兼容协议，可切换供应商）----
# provider: openai / deepseek / qwen / none
# 统一字段 LLM_API_KEY 优先级最高，填写后即生效（无需再配下面的供应商独立 Key）。
# 例：DeepSeek 官方  LLM_PROVIDER=deepseek / LLM_BASE_URL=https://api.deepseek.com/v1 / LLM_MODEL=deepseek-chat
# 例：阿里通义千问 LLM_PROVIDER=qwen     / LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 / LLM_MODEL=qwen-max
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ---- 各供应商独立配置（优先级低于上面的统一字段）----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- RAG / 向量库 ----
# 默认使用项目根 data/vectorstore（绝对路径），无需显式配置。
# VECTOR_STORE_PATH=./data/vectorstore
EMBEDDING_MODEL=hash-ngram-384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 取值：chroma / memory
VECTOR_STORE_TYPE=chroma
RAG_TOP_K=20

# ---- 知识库注入开关（true = 启动时跳过种子注入）----
SKIP_SEED=false

# ---- 外部 API（可选）----
AMAP_API_KEY=
WEATHER_API_KEY=
FLIGHT_API_KEY=

# ---- CORS（前端开发端口与部署域名）----
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://*.pocketbay.app"]
